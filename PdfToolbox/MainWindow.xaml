<Window x:Class="PdfToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Toolbox" Height="600" Width="900"
        AllowDrop="True" Drop="Window_Drop">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="File: " VerticalAlignment="Center"/>
            <TextBlock x:Name="FileNameText" Text="(未選択)" VerticalAlignment="Center" Width="400"/>
            <Button x:Name="OpenButton" Content="開く" Padding="8,2" Margin="4,0" Click="OpenButton_Click"/>
            <Button x:Name="SaveButton" Content="保存" Padding="8,2" Margin="4,0" IsEnabled="False" Click="SaveButton_Click"/>
        </StackPanel>

        <!-- Left: operation selector -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="操作" FontWeight="Bold" Margin="0,0,0,4"/>
            <RadioButton x:Name="RotateRadio" Content="回転" GroupName="Operation" IsChecked="True" Margin="0,2" Checked="OperationRadio_Checked"/>
            <RadioButton x:Name="SplitCenterRadio" Content="中央で切る" GroupName="Operation" Margin="0,2" Checked="OperationRadio_Checked"/>
            <RadioButton x:Name="SplitRadio" Content="分割" GroupName="Operation" Margin="0,2" Checked="OperationRadio_Checked"/>
            <RadioButton x:Name="MergeRadio" Content="結合" GroupName="Operation" Margin="0,2" Checked="OperationRadio_Checked"/>
            <RadioButton x:Name="PngRadio" Content="PNG変換" GroupName="Operation" Margin="0,2" Checked="OperationRadio_Checked"/>
        </StackPanel>

        <!-- Right: preview -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="Gray" BorderThickness="1">
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="PrevPageButton" Content="◀" Width="32" Click="PrevPageButton_Click"/>
                <TextBlock x:Name="PageIndicatorText" Text="0 / 0" VerticalAlignment="Center" Width="80" TextAlignment="Center"/>
                <Button x:Name="NextPageButton" Content="▶" Width="32" Click="NextPageButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Bottom: settings panels -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness="1" Margin="0,8,0,0" Padding="8">
            <Grid>
                <!-- Rotate panel -->
                <StackPanel x:Name="RotatePanel" Visibility="Visible">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="対象ページ (例 1-3,5 / all): " VerticalAlignment="Center"/>
                        <TextBox x:Name="RotateRangeText" Width="150" Text="all"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="回転角度: " VerticalAlignment="Center"/>
                        <ComboBox x:Name="RotateDegreeCombo" Width="100" SelectedIndex="0">
                            <ComboBoxItem Content="90"/>
                            <ComboBoxItem Content="180"/>
                            <ComboBoxItem Content="270"/>
                        </ComboBox>
                        <Button Content="実行" Padding="8,2" Margin="8,0,0,0" Click="RotateExecuteButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Split center panel -->
                <StackPanel x:Name="SplitCenterPanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="対象ページ (例 1-3,5 / all): " VerticalAlignment="Center"/>
                        <TextBox x:Name="SplitCenterRangeText" Width="150" Text="all"/>
                        <Button Content="実行" Padding="8,2" Margin="8,0,0,0" Click="SplitCenterExecuteButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Split panel -->
                <StackPanel x:Name="SplitPanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="分割範囲 (例 1-3,4-6): " VerticalAlignment="Center"/>
                        <TextBox x:Name="SplitRangeText" Width="200" Text=""/>
                        <Button Content="実行" Padding="8,2" Margin="8,0,0,0" Click="SplitExecuteButton_Click"/>
                    </StackPanel>
                    <TextBlock Text="カンマ区切りで複数範囲を指定すると範囲ごとに別ファイルとして保存されます" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Merge panel -->
                <StackPanel x:Name="MergePanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="現在のファイル: " VerticalAlignment="Center"/>
                        <TextBlock x:Name="MergeCurrentFileText" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ListBox x:Name="MergeFileListBox" Height="60" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="追加..." Padding="8,2" Click="MergeAddButton_Click"/>
                        <Button Content="結合" Padding="8,2" Margin="8,0,0,0" Click="MergeExecuteButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- PNG panel -->
                <StackPanel x:Name="PngPanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="対象ページ (例 1-3,5 / all): " VerticalAlignment="Center"/>
                        <TextBox x:Name="PngRangeText" Width="150" Text="all"/>
                        <Button Content="実行" Padding="8,2" Margin="8,0,0,0" Click="PngExecuteButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
